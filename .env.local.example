# Aroha Astrology — frontend environment
# Copy to .env.local and fill in real values. .env.local is gitignored.

# Backend API base URL (no trailing slash) — deployed v0.1.0 service
NEXT_PUBLIC_API_BASE_URL=http://13.232.179.137:3000

# Firebase web config — variable names match jyotish-backend so values can be
# copied directly from its .env. Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_AUTH_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_AUTH_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_APP_ID=
